# ============================================
# .htaccess for Stetson LLP - CLEAN URLs
# Removes .php from URLs without redirect loops
# ============================================

RewriteEngine On

# ============================================
# 1. FORCE HTTPS + REMOVE WWW (One redirect only)
# ============================================
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# ============================================
# 2. INTERNALLY REWRITE clean URL to .php file
# (No external redirect - browser shows clean URL)
# ============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# ============================================
# 3. CUSTOM 404 PAGE
# ============================================
ErrorDocument 404 /404.php

# ============================================
# 4. SECURITY - Block sensitive files
# ============================================
<FilesMatch "^(config|database|functions)\.php$">
    Require all denied
</FilesMatch>

# ============================================
# 5. CACHE CONTROL (Speed optimization)
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>